# Copy this file to a new file named exactly:  .env   (then edit the values)
BRAND_NAME=Briefkasten
PUBLIC_URL=http://localhost:3000
PORT=3000
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-long-password

# Free email sending with Gmail (see steps in chat).
# Replace YOU%40gmail.com with your address (keep %40 instead of @)
# Replace APPPASSWORD with the 16-letter Google app password, no spaces
SMTP_URL=smtps://YOU%40gmail.com:APPPASSWORD@smtp.gmail.com:465
MAIL_FROM=YOU@gmail.com

DB_PATH=./data/forms.db
MONTHLY_LIMIT=250
